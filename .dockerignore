.git
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
data/

# The api image is built from the repo root with `COPY . .`, so without these
# the frontend's node_modules and .next output (842 MB) get baked into the
# Flask image, which never reads a byte of them. Measured: a 1.41 GB image and
# a 39s incremental rebuild, vs ~220 MB and ~7s with them excluded.
frontend/
node_modules/
.next/

# CSV exports downloaded from /export.csv — gitignored, but the build context
# is a separate list and was picking them up.
*.csv

.env
.env.prod
